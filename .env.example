# Application
APP_NAME="API DESPES"
APP_ENV=development
APP_PORT=3000
APP_HOST=localhost

# JWT Authentication
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=3600s

# Database (MySQL - Laragon en local)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=soka_app

# API
API_VERSION=v1

# Mailer
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=

# Notifications SMS / WhatsApp via TextO (Journal - distribution)
# Mettre TEXTO_ENABLED=true pour activer l'envoi reel ; sinon le provider
# fonctionne en mode simulation (log uniquement) - pratique en dev.
TEXTO_ENABLED=false
TEXTO_BASE_URL=
TEXTO_API_KEY=
TEXTO_CLIENT_ID=
TEXTO_SENDER=SOKA CI
TEXTO_SMS_PATH=/sms/send
TEXTO_WA_PATH=/whatsapp/send
TEXTO_TIMEOUT_MS=10000

# ============================================================
#  SMS transactionnel (auth : 1re connexion + mot de passe oublie)
#
#  QUI DECIDE DU FOURNISSEUR ? Trois niveaux, du plus fort au plus faible :
#    1. la table app_settings (cle sms.active_provider) - bascule A CHAUD depuis
#       la page Parametres SMS, gagne toujours ;
#    2. SMS_ACTIVE_PROVIDER ci-dessous - defaut de DEPLOIEMENT, utilise seulement
#       si la ligne 1 est absente ;
#    3. la constante SMS_DEFAULT_ACTIVE_PROVIDER du code.
#  => Sur une base deja migree la ligne 1 EXISTE : changer SMS_ACTIVE_PROVIDER
#     seul n'aura aucun effet visible. Passer par la page Parametres SMS, ou
#     rejouer la migration SetSmsproAsDefaultProvider.
#
#  Le reste du .env ne porte que les credentials + l'autorisation d'envoi REEL :
#    *_ENABLED=false => aucun envoi reel (dev : pas de credits consommes / SIMULATION)
#    *_ENABLED=true  => envoi reel autorise
# ============================================================
# Fournisseur par defaut : smspro | letexto
SMS_ACTIVE_PROVIDER=smspro
# DIFFUSION (mode par defaut depuis le 2026-07-31) : true => le SMS part par TOUS
# les fournisseurs activees a la fois, le membre recoit donc 2 SMS. Quand c'est ON,
# SMS_ACTIVE_PROVIDER et le failover n'ont plus d'effet sur l'envoi.
# Meme hierarchie a 3 niveaux : app_settings 'sms.broadcast.enabled' gagne toujours
# (migration EnableSmsBroadcast). Mettre false pour revenir a un seul fournisseur.
SMS_BROADCAST_ENABLED=true
# --- SMSPro Africa (fournisseur par DEFAUT) ---
# Jeton : espace Developpeurs SMSPro (https://app.smspro.africa/developers/docs).
# Transport : base /api/v3 + en-tete Authorization: Bearer <token>.
# sender_id : 11 caracteres max, et il DOIT etre approuve cote SMSPro.
SMSPRO_API_TOKEN=
SMSPRO_BASE_URL=https://app.smspro.africa/api/v3
SMSPRO_SENDER_ID=SOKA CI
SMSPRO_ENABLED=true
SMSPRO_TIMEOUT_MS=8000
# --- LeTexto (2e fournisseur / repli) ---
LETEXTO_API_KEY=
LETEXTO_BASE_URL=https://apis.letexto.com/v1
LETEXTO_SENDER=SOKA CI
LETEXTO_ENABLED=false
LETEXTO_TIMEOUT_MS=8000


# ============================================================
#  SOKA Pay (microservice de paiement HUB2) - Phase 2
#  Optionnel : l'API demarre sans. Requis pour POST /payments/checkout
#  et le webhook POST /webhooks/soka-pay.
# ============================================================
# URL de base de l'API marchande SOKA Pay (gateway).
SOKA_PAY_BASE_URL=http://localhost:3001
# Cle API marchande SOKA Pay (sk_sandbox_... en sandbox).
SOKA_PAY_API_KEY=
# Secret HMAC partage : DOIT etre identique au secret du marchand cote SOKA Pay
# (Merchant.webhookSecret / SEED_MERCHANT_WEBHOOK_SECRET) pour verifier la signature.
SOKA_PAY_WEBHOOK_SECRET=
# URL publique de reception des callbacks (defaut : /api/webhooks/soka-pay,
# calcule depuis APP_HOST/APP_PORT si vide).
SOKA_PAY_CALLBACK_URL=

# ============================================================
#  Liens de paiement SOKA Pay (HubService) - abonnements & zaimu
#  Utilise par src/payments/hub.service.ts.
# ============================================================
# ATTENTION : malgre son nom, HUB_API_KEY n'est PAS une cle HUB2.
# HubService appelle la gateway SOKA Pay, pas HUB2 : la valeur attendue est une
# cle MARCHANDE SOKA Pay (sk_sandbox_... / sk_live_...), la meme famille que
# SOKA_PAY_API_KEY ci-dessus. Son environnement doit correspondre a celui de la
# gateway (GET /api/health -> hub2Environment), sinon 401.
# Les vraies cles HUB2 vivent uniquement dans soka-pay/api/.env (HUB2_API_KEY /
# HUB2_API_KEY_LIVE) : la gateway est le seul composant qui parle a HUB2.
# Pour en creer une : soka-pay/api -> npx tsx scripts/create-api-key.ts "libelle"
HUB_API_KEY=
# URL des liens de paiement (defaut : https://pay-api.sokagakkaici.org/api/v1/payment-links).
HUB_API_URL=
# URL de retour du guichet apres paiement.
HUB_RETURN_URL=
# Interrupteur de POSTE DE TEST : 'false' desarme le cron de synchronisation Hub.
# OBLIGATOIRE quand une API locale pointe HUB_API_URL vers la PRODUCTION : le cron
# referme des liens abandonnes (ecriture au guichet). Defaut (absent/autre valeur) : arme.
HUB_SYNC_CRON_ENABLED=